<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>14</LangVersion>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
      <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        <PrivateAssets>all</PrivateAssets>
      </PackageReference>
      <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
      <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite.Core" Version="10.0.12" />
      <!-- Overrides the older SQLite bundle EF Core references (GHSA-2m69-gcr7-jv3q) -->
      <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
      <PackageReference Include="Remora.Discord.API" Version="81.0.0" />
      <PackageReference Include="Remora.Rest.Core" Version="4.0.0" />
    </ItemGroup>

</Project>
