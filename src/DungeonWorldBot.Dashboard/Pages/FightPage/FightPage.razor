@page "/fight/{Id:int}"
@page "/session/{Session:int}/fight/{Id:int}"
@namespace DungeonWorldBot.Dashboard.Pages
@using DungeonWorldBot.Dashboard.Models.Encounters
@using DungeonWorldBot.Dashboard.Models.Sessions
@using DungeonWorldBot.Dashboard.Services.Encounters
@using DungeonWorldBot.Dashboard.Services.Sessions
@using System.Text.Json
@inject FightReplayReader Replays
@inject SessionReader Sessions
@inject NavigationManager Navigation
@inject Viewer Viewer

@* A fight played back from its timeline: who did what to whom, step by step, with the hits landing and enemies falling.
   replay.js plays it from the data below. It doesn't refresh itself (data-no-live), so a replay isn't cut off halfway. *@
@if (_replay is not { } r)
{
    <PageTitle>Not found · Sana Solem</PageTitle>
    <p class="empty">No fight with that number. <a href="bestiary">To the bestiary</a></p>
    return;
}

<PageTitle>⚔️ @r.Fight.Name · Sana Solem</PageTitle>

@if (_session is { } during)
{
    <a class="back" href="@during.Url">← @during.Name</a>
}

<header class="fight-head">
    <h1>⚔️ @r.Fight.Name</h1>
    <div class="muted">
        @r.Fight.StartedAt.ToLocalTime().ToString("dddd d MMMM yyyy, h:mm tt")
        @if (r.Fight.SceneID is { } scene)
        {
            <span> · on <a href="scene/@scene">@(r.Fight.SceneName ?? "its scene")</a></span>
        }
        @(r.Fight.EndedAt is null ? " · still going" : "")
    </div>
</header>

@if (r.Steps.Count == 0)
{
    <p class="empty">Nothing happened in this fight yet, so there's nothing to replay.</p>
    return;
}

<div class="replay" data-no-live data-replay>
    <div class="replay-stage">
        <div class="replay-side party" data-side="party"></div>
        <div class="replay-middle">
            <div class="replay-caption" data-caption aria-live="polite"></div>
        </div>
        <div class="replay-side enemies" data-side="enemies"></div>
        @* Everyone's face, for replay.js to put on their card *@
        <template data-faces>
            @foreach (var f in r.Fighters)
            {
                <span data-face="@f.Key"><Face Name="@f.Name" Picture="@f.Portrait" /></span>
            }
        </template>
        <svg class="replay-arrow" data-arrow aria-hidden="true">
            <defs><marker id="replay-head" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" /></marker></defs>
            <path marker-end="url(#replay-head)" />
        </svg>
    </div>

    <div class="replay-controls card">
        <button type="button" class="tool" data-step="-1" title="Back a step (←)" aria-label="Back a step">⏮</button>
        <button type="button" class="tool play" data-play title="Play or pause (Space)" aria-label="Play">▶</button>
        <button type="button" class="tool" data-step="1" title="Forward a step (→)" aria-label="Forward a step">⏭</button>
        <input type="range" min="0" max="@r.Steps.Count" value="0" data-scrub aria-label="Where in the fight" />
        <span class="replay-count small" data-count>0 / @r.Steps.Count</span>
        <select class="filter" data-speed aria-label="Speed">
            <option value="2200">Slow</option>
            <option value="1400" selected>Normal</option>
            <option value="700">Fast</option>
        </select>
    </div>

    <ol class="replay-log card" data-log>
        @foreach (var (step, i) in r.Steps.Select((s, i) => (s, i)))
        {
            <li data-index="@(i + 1)" title="@step.Line">
                <div class="replay-who"><strong>@step.ActorName</strong><span class="muted">@step.At</span></div>
                <div class="action-line">
                    <span class="action">@step.Action</span>
                    @if (step.TargetName is not null)
                    {
                        <span class="target">→ @step.TargetName</span>
                    }
                </div>
                @if (step.Roll is not null || step.Result is not null)
                {
                    <div class="outcome-line">
                        @if (step.Roll is not null)
                        {
                            <span class="roll-pill @step.RollClass">@step.ShortRoll</span>
                        }
                        @if (step.Result is not null)
                        {
                            <span class="dmg">@step.ShortResult</span>
                        }
                    </div>
                }
            </li>
        }
    </ol>
</div>

<script type="application/json" data-replay-data>@((MarkupString)_json)</script>
<script src="replay.js" defer></script>

@code {
    [Parameter]
    public int Id { get; set; }

    [Parameter]
    public int? Session { get; set; }

    private FightReplay? _replay;
    private SessionSummary? _session;
    private string _json = "{}";

    protected override async Task OnInitializedAsync()
    {
        _replay = await Replays.GetAsync(Id);
        if (_replay is not { } r)
            return;

        // A fight from a game night belongs under that session (and the Sessions tab); others stay under Scenes
        _session = await Sessions.GetDuringAsync(r.Fight);
        if (_session?.Number != Session)
            Navigation.NavigateTo(_session is { } during ? $"{during.Url}/fight/{Id}" : $"fight/{Id}", replace: true);

        // Everyone's health after each step, worked out here so players never get an enemy's max HP: they see how hurt
        // an enemy looks, so for them it goes down in quarters. The party's own is exact for everyone, as is the lot
        // for whoever runs the fight.
        var exact = Viewer.CanRunGame;
        var tracked = r.Fighters.Where(f => f.MaxHP is > 0).ToList();
        var lost = new Dictionary<string, int>();
        Dictionary<string, double> Shares() => tracked.ToDictionary(f => f.Key, f =>
        {
            var share = Math.Max(0, 1 - lost.GetValueOrDefault(f.Key) / (double)f.MaxHP!.Value);
            return exact || share <= 0 || f.Side == "party" ? share : Math.Ceiling(share * 4) / 4;
        });
        var health = new List<Dictionary<string, double>> { Shares() };
        foreach (var step in r.Steps)
        {
            if (step.Target is { } target && step.Damage > 0)
                lost[target] = lost.GetValueOrDefault(target) + step.Damage;
            health.Add(Shares());
        }

        _json = JsonSerializer.Serialize(new
        {
            exact,
            fighters = r.Fighters.Select(f => new
            {
                f.Key, f.Name, f.Side, f.Color,
                Tracked = f.MaxHP is > 0,
                MaxHP = exact || f.Side == "party" ? f.MaxHP : null,
            }),
            steps = r.Steps,
            health,
        }, new JsonSerializerOptions(JsonSerializerDefaults.Web));
    }
}
