@page "/stats"
@namespace DungeonWorldBot.Dashboard.Pages
@using DungeonWorldBot.Dashboard.Models.Rolls
@using DungeonWorldBot.Dashboard.Services.Rolls
@using DungeonWorldBot.Features.Rolls
@inject IRollStatsService RollStats
@inject RollReader RollReader
@inject PartyReader PartyReader
@inject DashboardSettings Settings
@inject Viewer Viewer

<PageTitle>Roll stats · Sana Solem</PageTitle>

<PageHeader Title="Roll stats" Description="Every 2d6 roll in the game chat, counted by total with modifiers. The totals up top are the party's, without the DM's rolls. Run /stats scan in Discord to add older rolls." />

@if (_stats.Count == 0)
{
    <p class="empty">No rolls recorded yet.</p>
}
else
{
    <div class="tiles">
        <StatTile Label="Rolls">@_table.Rolls</StatTile>
        <StatTile Label="Hit rate">@Percent(_party.Sum(s => s.StrongHits + s.WeakHits), _table.Rolls)</StatTile>
        <StatTile Label="Avg dice" Note="fair dice: 7.0">@Avg(_table.AverageNatural)</StatTile>
        <StatTile Label="Avg total" Note="with modifiers">@Avg(_table.AverageTotal)</StatTile>
        <StatTile Label="Lifted by mods" Note="@($"sank {_party.Sum(s => s.Sunk)}")">@_party.Sum(s => s.Lifted)</StatTile>
        <StatTile Label="Nat 12s">@_party.Sum(s => s.Natural12s)</StatTile>
        <StatTile Label="Nat 2s">@_party.Sum(s => s.Natural2s)</StatTile>
    </div>

    <div class="card table-card">
        <table>
            <thead>
                <tr>
                    <th>Player</th>
                    <th class="num">Rolls</th>
                    <th class="num">10+</th>
                    <th class="num">7–9</th>
                    <th class="num">6−</th>
                    <th class="num">Nat 12</th>
                    <th class="num">Nat 2</th>
                    <th class="num" title="Average of the two dice, before modifiers. Fair dice average 7.">Avg dice</th>
                    <th class="num">Avg total</th>
                    <th class="num" title="Rolls their modifiers moved up a band (like 6 + 1 into a 7–9), then down a band (like 7 − 1 into a miss).">Lifted / sank</th>
                    <th title="Average dice each of the last @RollReader.LuckSessions sessions. The dashed line is fair dice (7).">Luck</th>
                    <th class="spread">Spread</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in _stats)
                {
                    var spread = _players.GetValueOrDefault(s.UserID.Value);
                    <tr class="@(s.UserID.Value == _dungeonMaster ? "dm-row" : "") @(Viewer.Is(s.UserID.Value) ? "mine" : "")">
                        <td>@Player(s.UserID.Value)</td>
                        <td class="num">@s.Rolls</td>
                        <td class="num">@s.StrongHits</td>
                        <td class="num">@s.WeakHits</td>
                        <td class="num">@s.Misses</td>
                        <td class="num">@s.Natural12s</td>
                        <td class="num">@s.Natural2s</td>
                        <td class="num @Luck(spread?.Rolls ?? 0, spread?.AverageNatural ?? 0)">@Avg(spread?.AverageNatural)</td>
                        <td class="num">@Avg(spread?.AverageTotal)</td>
                        <td class="num">@s.Lifted / @s.Sunk</td>
                        <td class="luck">@Sparkline(s.UserID.Value)</td>
                        <td class="spread">
                            <div class="spread-bar" title="@Percent(s.StrongHits, s.Rolls) strong · @Percent(s.WeakHits, s.Rolls) weak · @Percent(s.Misses, s.Rolls) miss">
                                <div class="strong" style="flex-grow: @s.StrongHits"></div>
                                <div class="weak" style="flex-grow: @s.WeakHits"></div>
                                <div class="miss" style="flex-grow: @s.Misses"></div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="legend">
        <span><i class="strong"></i>Strong hit</span>
        <span><i class="weak"></i>Weak hit</span>
        <span><i class="miss"></i>Miss</span>
        <span><i class="expected"></i>Fair dice</span>
    </div>

    @if (_nerdery.LastSession is { Awards.Count: > 0 } last)
    {
        <h2 class="section-title">Last session's awards</h2>
        <p class="small">Who stood out @(last.Name is { } name ? $"in {name}, " : "")on @last.Started.ToString("dddd d MMMM").</p>
        <AwardCards Awards="last.Awards" Party="_characters" />
    }

    <h2 class="section-title">Sessions</h2>
    <p class="small">Game nights, worked out from when the party rolled. Sessions marked with /session start and end are counted as they ran; otherwise a session ends after @((int)RollReader.SessionGap.TotalHours) hours without a roll. The stronger a day's colour, the more the party rolled. Click one to see how it went.</p>
    <SessionCalendar Sessions="_breakdown.Sessions" />

    <h2 class="section-title">By move</h2>
    @if (_breakdown.Moves.Count == 0)
    {
        <p class="empty">No rolls are tied to a move yet. Rolls with /move, or a "." roll labelled with a move's name (like ".str hack and slash"), are counted here. Run /stats scan to fill in older ones.</p>
    }
    else
    {
        <p class="small">The party's rolls for each move.@(_breakdown.Unlabelled > 0 ? $" {_breakdown.Unlabelled} rolls weren't for a move and aren't shown." : "")</p>
        @Tallies(_breakdown.Moves, "Move")
    }

    @if (_nerdery.Heatmap is { Rows.Count: > 0, Players.Count: > 1 } heatmap)
    {
        <h2 class="section-title">Who's good at what</h2>
        <p class="small">Hit rate (7+) for each player's most rolled moves. Greener is better; the number is how many times they rolled it, and the fewer rolls, the fainter the colour.</p>
        <div class="card table-card">
            <table class="heatmap">
                <thead>
                    <tr>
                        <th>Move</th>
                        @foreach (var p in heatmap.Players)
                        {
                            <th class="heat-player">@Player(p)</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in heatmap.Rows)
                    {
                        <tr>
                            <td>@row.Move</td>
                            @foreach (var cell in row.Cells)
                            {
                                @if (cell is { } t)
                                {
                                    var rate = (t.StrongHits + t.WeakHits) / (double)t.Rolls;
                                    <td class="heat" style="--rate: @Num(rate, "0.00"); --sure: @Num(Math.Min(1, t.Rolls / 5.0), "0.00")"
                                        title="@Percent(t.StrongHits + t.WeakHits, t.Rolls) hit · @t.StrongHits strong · @t.WeakHits weak · @t.Misses miss">
                                        <strong>@Percent(t.StrongHits + t.WeakHits, t.Rolls)</strong>
                                        <span>@t.Rolls</span>
                                    </td>
                                }
                                else
                                {
                                    <td class="heat none">–</td>
                                }
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (_breakdown.Stats.Count > 0)
    {
        <h2 class="section-title">By stat</h2>
        <p class="small">The party's rolls by the stat they rolled with.</p>
        @Tallies(_breakdown.Stats, "Stat")
    }

    <h2 class="section-title">Dice sums</h2>
    <p class="small">What the two dice showed before modifiers. The line marks how often fair dice land on each sum.</p>
    <div class="dice-grid">
        <section class="card">
            <h3>Party <span class="small">· @_table.Rolls rolls</span></h3>
            <DiceChart Spread="_table" />
        </section>
        @foreach (var s in _stats)
        {
            if (_players.GetValueOrDefault(s.UserID.Value) is not { } spread)
                continue;
            <section class="card">
                <h3>@Player(s.UserID.Value) <span class="small">· @spread.Rolls rolls</span></h3>
                <DiceChart Spread="spread" />
            </section>
        }
    </div>
}

@code {
    private ulong _dungeonMaster;
    private IReadOnlyList<PlayerRollStats> _stats = [];
    private IEnumerable<PlayerRollStats> _party => _stats.Where(s => s.UserID.Value != _dungeonMaster);
    private DiceSpread _table = DiceSpread.Of([]);
    private IReadOnlyDictionary<ulong, DiceSpread> _players = new Dictionary<ulong, DiceSpread>();
    private RollBreakdown _breakdown = new([], [], [], 0);
    private RollNerdery _nerdery = new([], new MoveHeatmap([], []), null);
    private Dictionary<string, string> _names = new();
    private IReadOnlyList<CharacterView> _characters = [];

    protected override async Task OnInitializedAsync()
    {
        _dungeonMaster = Settings.DungeonMasterID;

        // Players first, most rolls first, then the DM
        _stats = (await RollStats.GetStatsAsync()).OrderBy(s => s.UserID.Value == _dungeonMaster).ToList();
        var spreads = await RollReader.GetSpreadsAsync(leaveOut: _dungeonMaster);
        _table = spreads.Table;
        _players = spreads.Players;
        _breakdown = await RollReader.GetBreakdownAsync(leaveOut: _dungeonMaster);
        _nerdery = await RollReader.GetNerderyAsync(leaveOut: _dungeonMaster);
        _characters = await PartyReader.GetPartyAsync();
        _names = _characters.ToDictionary(c => c.ID, c => c.Name);
    }

    // Characters share their player's Discord ID
    private RenderFragment Player(ulong userID) => userID == _dungeonMaster
        ? @<span class="chip accent">DM</span>
        : _names.TryGetValue(userID.ToString(), out var name)
            ? @<a href="character/@Lookup.Slug(name)">@name</a>
            : @<span>Player @userID</span>;

    private static RenderFragment Tallies(IReadOnlyList<OutcomeTally> tallies, string heading) =>
        @<div class="card table-card">
            <table>
                <thead>
                    <tr>
                        <th>@heading</th>
                        <th class="num">Rolls</th>
                        <th class="num">10+</th>
                        <th class="num">7–9</th>
                        <th class="num">6−</th>
                        <th class="num">Hit rate</th>
                        <th class="spread">Spread</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in tallies)
                    {
                        <tr>
                            <td>@t.Name</td>
                            <td class="num">@t.Rolls</td>
                            <td class="num">@t.StrongHits</td>
                            <td class="num">@t.WeakHits</td>
                            <td class="num">@t.Misses</td>
                            <td class="num">@Percent(t.StrongHits + t.WeakHits, t.Rolls)</td>
                            <td class="spread">
                                <div class="spread-bar" title="@Percent(t.StrongHits, t.Rolls) strong · @Percent(t.WeakHits, t.Rolls) weak · @Percent(t.Misses, t.Rolls) miss">
                                    <div class="strong" style="flex-grow: @t.StrongHits"></div>
                                    <div class="weak" style="flex-grow: @t.WeakHits"></div>
                                    <div class="miss" style="flex-grow: @t.Misses"></div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>;

    // Each session's average dice as a little line, with fair dice (7) dashed across it. Dice averages rarely leave 4–10.
    private RenderFragment Sparkline(ulong userID)
    {
        if (_nerdery.Luck.FirstOrDefault(l => l.UserID == userID) is not { } trend || trend.Sessions.All(s => s is null))
            return @<span class="muted">–</span>;

        const double width = 80, height = 26, low = 4, high = 10;
        var step = trend.Sessions.Count > 1 ? width / (trend.Sessions.Count - 1) : 0;
        string Y(double value) => Num(height - (Math.Clamp(value, low, high) - low) / (high - low) * height, "0.0");
        string X(int i) => Num(i * step, "0.0");
        var points = trend.Sessions.Select((v, i) => (v, i)).Where(p => p.v is not null).ToList();
        var line = string.Join(' ', points.Select(p => $"{X(p.i)},{Y(p.v!.Value)}"));
        var title = string.Join(" · ", trend.Sessions.Select(v => v is { } a ? a.ToString("0.0") : "–"));

        return @<svg class="sparkline" viewBox="-3 -3 @(width + 6) @(height + 6)" width="@(width + 6)" height="@(height + 6)" role="img" aria-label="Average dice by session: @title">
            <title>@title</title>
            <line class="fair" x1="0" x2="@width" y1="@Y(7)" y2="@Y(7)" />
            <polyline points="@line" />
            @foreach (var (v, i) in points)
            {
                <circle cx="@X(i)" cy="@Y(v!.Value)" r="2.5" class="@(v >= 7.5 ? "hot" : v <= 6.5 ? "cold" : "")" />
            }
        </svg>;
    }

    private static string Avg(double? value) => value is { } v ? v.ToString("0.0") : "–";
}
