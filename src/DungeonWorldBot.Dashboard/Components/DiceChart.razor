@using DungeonWorldBot.Dashboard.Rolls
@* Natural 2d6 sums as bars, with a tick where fair dice would land *@
<div class="dice-chart">
    @for (var sum = 2; sum <= 12; sum++)
    {
        var count = Spread.Sums[sum - 2];
        var share = Spread.Rolls == 0 ? 0 : count / (double)Spread.Rolls;
        var expected = DiceSpread.Expected(sum);
        <div class="dice-col" title="@sum: @count roll@(count == 1 ? "" : "s") (@Pct(share), fair dice @Pct(expected))">
            <div class="dice-track">
                <div class="dice-bar @Band(sum)" style="height: @Css(share / _top)%"></div>
                <div class="dice-expected" style="bottom: @Css(expected / _top)%"></div>
            </div>
            <span class="dice-count">@count</span>
            <span class="dice-sum">@sum</span>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public DiceSpread Spread { get; set; } = null!;

    // The tallest bar or fair-dice tick sets the scale
    private double _top = 1;

    protected override void OnParametersSet()
    {
        var tallest = Spread.Rolls == 0 ? 0 : Spread.Sums.Max() / (double)Spread.Rolls;
        _top = Math.Max(tallest, DiceSpread.Expected(7)) * 1.05;
    }

    // Colored by what the dice alone would get, before modifiers
    private static string Band(int sum) => sum switch
    {
        >= 10 => "strong",
        >= 7 => "weak",
        _ => "miss",
    };

    private static string Css(double fraction) => (fraction * 100).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);

    private static string Pct(double fraction) => fraction.ToString("0%");
}
