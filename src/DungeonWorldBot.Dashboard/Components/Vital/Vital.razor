@namespace DungeonWorldBot.Dashboard.Components
@* One number in a header's vitals (.hero-vitals), like armor or damage, with a few words under it *@
<div class="vital @Kind" title="@Title">
    <span class="tile-label">
        @if (Icon is not null)
        {
            <Icon Name="@Icon" />
        }
        @Label
    </span>
    <strong>@ChildContent</strong>
    @if (Note is not null)
    {
        <span class="small">@Note</span>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    [Parameter]
    public string? Icon { get; set; }

    /// <summary>
    /// The number itself.
    /// </summary>
    [Parameter, EditorRequired]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// A few words under the number, like "before gear".
    /// </summary>
    [Parameter]
    public string? Note { get; set; }

    /// <summary>
    /// Its color class, like "armor" or "damage".
    /// </summary>
    [Parameter]
    public string? Kind { get; set; }

    /// <summary>
    /// Shown on hover.
    /// </summary>
    [Parameter]
    public string? Title { get; set; }
}
