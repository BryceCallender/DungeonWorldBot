@namespace DungeonWorldBot.Dashboard.Components
@* Quick damage and healing for an NPC or an enemy, so a hit doesn't need the whole sheet opened *@
<form method="post" action="@Action" class="hp-change">
    <AntiforgeryToken />
    <input class="filter" type="number" name="amount" min="1" value="1" aria-label="How much to hurt or heal @Name" />
    <button class="tool" name="change" value="damage" title="Reduced by armor">Damage</button>
    <button class="tool" name="change" value="heal">Heal</button>
</form>

@code {
    /// <summary>
    /// Where the form posts, e.g. api/npcs/3/hp.
    /// </summary>
    [Parameter, EditorRequired]
    public string Action { get; set; } = "";

    /// <summary>
    /// Who it's for, to label the amount.
    /// </summary>
    [Parameter, EditorRequired]
    public string Name { get; set; } = "";
}
