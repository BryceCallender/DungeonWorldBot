@namespace DungeonWorldBot.Dashboard.Components
<div class="hp">
    <Meter Label="HP" Icon="heart" Value="CurrentHP" Max="MaxHP" Fill="@Band" />
</div>

@code {
    /// <summary>
    /// A character's health. Leave it out and set <see cref="Current"/> and <see cref="Max"/> for anyone else, like an NPC.
    /// </summary>
    [Parameter]
    public CharacterView? View { get; set; }

    [Parameter]
    public int Current { get; set; }

    [Parameter]
    public int Max { get; set; }

    private int CurrentHP => View?.CurrentHP ?? Current;
    private int MaxHP => View?.MaxHP ?? Max;
    private double Percent => MaxHP <= 0 ? 0 : Math.Clamp(CurrentHP / (double)MaxHP * 100, 0, 100);

    private string Band => Percent switch
    {
        > 50 => "good",
        > 25 => "low",
        _ => "critical",
    };
}
