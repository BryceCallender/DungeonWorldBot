@namespace DungeonWorldBot.Dashboard.Components

@* Who the party has bonds with, drawn as a web: each character round the ring in their class color, an arrow from each
   to everyone they've a bond with, and a thicker double-headed line where two have bonds with each other. Pointing at
   someone (app.js) lights up their bonds and fades the rest. Bonds with anyone outside the party (an NPC, someone
   who's left) sit round the outside in gray. *@
@if (_nodes.Count > 0 && _edges.Count > 0)
{
    <svg class="bond-web" viewBox="0 0 @Num(Width) @Num(Height)" role="img" aria-label="The party's bonds" data-bond-web>
        <defs>
            <marker id="bond-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                <path d="M0,0 L10,5 L0,10 z" />
            </marker>
            @foreach (var node in _nodes.Where(n => n.Portrait is not null))
            {
                <clipPath id="bond-clip-@node.ID"><circle cx="@Num(node.X)" cy="@Num(node.Y)" r="@Num(node.Radius)" /></clipPath>
            }
        </defs>

        @foreach (var edge in _edges)
        {
            <g class="bond-edge classed @(edge.Mutual ? "mutual" : "")" style="@edge.Color" data-from="@edge.From.ID" data-to="@edge.To.ID">
                <title>@edge.Title</title>
                <path d="@edge.Path" marker-end="url(#bond-arrow)" marker-start="@(edge.Mutual ? "url(#bond-arrow)" : null)" />
            </g>
        }

        @foreach (var node in _nodes)
        {
            <a class="bond-node classed @(node.Outsider ? "outsider" : "")" href="@node.Url" style="@node.Color" data-id="@node.ID">
                <title>@node.Name · has bonds with @node.Out, @node.In with them</title>
                <circle class="ring" cx="@Num(node.X)" cy="@Num(node.Y)" r="@Num(node.Radius + 3)" />
                @if (node.Portrait is { } picture)
                {
                    <image href="@picture" x="@Num(node.X - node.Radius)" y="@Num(node.Y - node.Radius)" width="@Num(node.Radius * 2)" height="@Num(node.Radius * 2)"
                           preserveAspectRatio="xMidYMid slice" clip-path="url(#bond-clip-@node.ID)" />
                }
                else
                {
                    @* In a group, since Razor reads a bare <text> in code as its own tag *@
                    <g>
                        <circle class="face" cx="@Num(node.X)" cy="@Num(node.Y)" r="@Num(node.Radius)" />
                        <text class="initial" x="@Num(node.X)" y="@Num(node.Y)" dy=".35em">@node.Name[..1]</text>
                    </g>
                }
                <text class="label" x="@Num(node.X)" y="@Num(node.Y + node.Radius + 18)">@node.Name</text>
            </a>
        }
    </svg>
}

@code {
    /// <summary>
    /// The party, who are drawn round the ring.
    /// </summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<CharacterView> Party { get; set; } = [];

    /// <summary>
    /// Characters' pictures by their ID, where they have one.
    /// </summary>
    [Parameter]
    public IReadOnlyDictionary<ulong, string> Portraits { get; set; } = new Dictionary<ulong, string>();

    private const double Width = 640, Height = 420, PartyRadius = 30, OutsiderRadius = 20;

    // How far an arrow bows out from a straight line, so a pair's two arrows don't sit on top of each other
    private const double Bow = 22;

    private List<Node> _nodes = [];
    private List<Edge> _edges = [];

    private record Node(ulong ID, string Name, string Url, string Color, string? Portrait, bool Outsider, double X, double Y, double Radius)
    {
        public int Out { get; set; }
        public int In { get; set; }
    }

    private record Edge(Node From, Node To, bool Mutual, string Color, string Path, string Title);

    protected override void OnParametersSet()
    {
        var bonds = Party
            .SelectMany(c => (c.Character.Bonds ?? []).Select(b => (From: c.Character.ID.Value, To: b.TargetID.Value, b.TargetName)))
            .Where(b => b.From != b.To)
            .Distinct()
            .ToList();

        // The party round an ellipse, starting at the top; anyone else round a wider one outside it
        var cx = Width / 2;
        var cy = Height / 2 - 10;
        _nodes = Party
            .Select((c, i) =>
            {
                var angle = -Math.PI / 2 + i * 2 * Math.PI / Party.Count;
                return new Node(c.Character.ID.Value, c.Name, c.Url, Lookup.ColorOf(c.Character.Class.Type), Portraits.GetValueOrDefault(c.Character.ID.Value),
                    false, cx + Math.Cos(angle) * 220, cy + Math.Sin(angle) * 135, PartyRadius);
            })
            .ToList();

        var outsiders = bonds.Where(b => _nodes.All(n => n.ID != b.To)).DistinctBy(b => b.To).ToList();
        _nodes.AddRange(outsiders.Select((b, i) =>
        {
            var angle = -Math.PI / 4 + i * 2 * Math.PI / Math.Max(outsiders.Count, 1);
            return new Node(b.To, b.TargetName, $"character/{b.To}", "", null, true, cx + Math.Cos(angle) * 290, cy + Math.Sin(angle) * 170, OutsiderRadius);
        }));

        var byId = _nodes.ToDictionary(n => n.ID);
        var pairs = bonds.Select(b => (b.From, b.To)).ToHashSet();
        _edges = [];
        foreach (var (fromId, toId, _) in bonds)
        {
            if (!byId.TryGetValue(fromId, out var from) || !byId.TryGetValue(toId, out var to))
                continue;

            from.Out++;
            to.In++;

            // A pair with bonds both ways is drawn once, as a straight line with an arrow at each end
            var mutual = pairs.Contains((toId, fromId));
            if (mutual && fromId > toId)
                continue;

            _edges.Add(new Edge(from, to, mutual, from.Color, PathBetween(from, to, mutual ? 0 : Bow),
                mutual ? $"{from.Name} and {to.Name} have bonds with each other" : $"{from.Name} has a bond with {to.Name}"));
        }
    }

    // A curve from one's edge to the other's, bowed to the side so arrows each way between a pair stay apart
    private static string PathBetween(Node from, Node to, double bow)
    {
        var (dx, dy) = (to.X - from.X, to.Y - from.Y);
        var length = Math.Sqrt(dx * dx + dy * dy);
        var (ux, uy) = (dx / length, dy / length);
        var (nx, ny) = (-uy, ux);
        var gap = 6;
        var (x1, y1) = (from.X + ux * (from.Radius + gap) + nx * bow * .3, from.Y + uy * (from.Radius + gap) + ny * bow * .3);
        var (x2, y2) = (to.X - ux * (to.Radius + gap) + nx * bow * .3, to.Y - uy * (to.Radius + gap) + ny * bow * .3);
        var (mx, my) = ((from.X + to.X) / 2 + nx * bow, (from.Y + to.Y) / 2 + ny * bow);
        return $"M{Num(x1)},{Num(y1)} Q{Num(mx)},{Num(my)} {Num(x2)},{Num(y2)}";
    }
}
