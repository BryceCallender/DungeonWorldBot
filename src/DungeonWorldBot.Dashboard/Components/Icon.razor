@* Small icons drawn in the current text color, so CSS can tint them (emoji can't be recolored) *@
<svg class="icon icon-@Name" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" fill="currentColor">
    @switch (Name)
    {
        case "heart":
            <path d="M12 21s-7.2-4.5-9.5-9.2C1 8.6 3 5 6.6 5c2.1 0 3.6 1.1 4.4 2.5h2C13.8 6.1 15.3 5 17.4 5 21 5 23 8.6 21.5 11.8 19.2 16.5 12 21 12 21z" />
            break;
        case "shield":
            <path d="M12 2 4 5.2v6.1c0 5 3.4 9.4 8 10.7 4.6-1.3 8-5.7 8-10.7V5.2L12 2z" />
            break;
        case "magic":
            <path d="M12 2.5 14 9l6.5 2-6.5 2-2 6.5-2-6.5L3.5 11 10 9l2-6.5z" />
            <path d="M19 2.5l.8 2.2 2.2.8-2.2.8L19 8.5l-.8-2.2-2.2-.8 2.2-.8L19 2.5z" opacity=".7" />
            break;
        case "divine":
            <path d="M12 7.5a4.5 4.5 0 1 1 0 9 4.5 4.5 0 0 1 0-9z" />
            <path d="M11 1.5h2v4h-2zM11 18.5h2v4h-2zM1.5 11h4v2h-4zM18.5 11h4v2h-4zM4.2 5.6l1.4-1.4 2.8 2.8L7 8.4zM16.6 17l1.4-1.4 2.8 2.8-1.4 1.4zM4.2 18.4 7 15.6 8.4 17l-2.8 2.8zM15.6 7l2.8-2.8 1.4 1.4L17 8.4z" opacity=".8" />
            break;
        case "sword":
            <path d="M20.5 2.5v4L10.9 16.1l-3-3L17.5 3.5h3z" />
            <path d="M5.4 12.6l6 6-1.4 1.4-1.6-1.6-2.8 2.8a1.4 1.4 0 0 1-2-2l2.8-2.8L4 14l1.4-1.4z" />
            break;
        @* The canvas board's tools *@
        case "pen":
            <path d="M3 17.25V21h3.75L17.8 9.94l-3.75-3.75L3 17.25zM20.7 7.04a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" />
            break;
        case "eraser":
            <path d="M16.24 3.56l4.95 4.94c.78.79.78 2.05 0 2.84L12 20.53a4 4 0 0 1-5.66 0L2.81 17c-.78-.79-.78-2.05 0-2.84l10.6-10.6c.79-.78 2.05-.78 2.83 0zM4.22 15.58l3.54 3.53c.78.79 2.04.79 2.83 0l3.53-3.53-4.95-4.95-4.95 4.95z" />
            break;
        @* A card's menu *@
        case "more":
            <circle cx="5" cy="12" r="2" /><circle cx="12" cy="12" r="2" /><circle cx="19" cy="12" r="2" />
            break;
        case "move":
            <path d="M12 2l3 3h-2v4h4V7l3 3-3 3v-2h-4v4h2l-3 3-3-3h2v-4H7v2l-3-3 3-3v2h4V5H9l3-3z" />
            break;
        case "token":
            <path d="M12 3a9 9 0 1 1 0 18 9 9 0 0 1 0-18zm0 3a6 6 0 1 0 0 12 6 6 0 0 0 0-12z" />
            <circle cx="12" cy="12" r="3" />
            break;
        case "undo":
            <path d="M12.5 8c-2.65 0-5.05.99-6.9 2.6L2 7v9h9l-3.62-3.62c1.39-1.16 3.16-1.88 5.12-1.88 3.54 0 6.55 2.31 7.6 5.5l2.37-.78C21.08 11.03 17.15 8 12.5 8z" />
            break;
        case "text":
            <path d="M5 4v3h5.5v12h3V7H19V4H5z" />
            break;
        case "image":
            <path d="M21 19V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2zM8.5 13.5l2.5 3 3.5-4.5 4.5 6H5l3.5-4.5z" />
            break;
        case "shapes":
            <path d="M11 13.5v8H3v-8h8zm-2 2H5v4h4v-4zM12 2l5.5 9h-11L12 2zm0 3.86L10.08 9h3.84L12 5.86zM17.5 13c2.5 0 4.5 2 4.5 4.5S20 22 17.5 22 13 20 13 17.5s2-4.5 4.5-4.5zm0 2a2.5 2.5 0 0 0 0 5 2.5 2.5 0 0 0 0-5z" />
            break;
        case "rect":
            <path d="M3 5v14h18V5H3zm16 12H5V7h14v10z" />
            break;
        case "ellipse":
            <path d="M12 6c-4.97 0-9 2.69-9 6s4.03 6 9 6 9-2.69 9-6-4.03-6-9-6zm0 10c-3.86 0-7-1.79-7-4s3.14-4 7-4 7 1.79 7 4-3.14 4-7 4z" />
            break;
        case "line":
            <path d="M4 18.6 18.6 4 20 5.4 5.4 20z" />
            break;
        case "arrow":
            <path d="M5 17.59 15.59 7H9V5h10v10h-2V8.41L6.41 19z" />
            break;
        @* Scene kinds, for cards without a thumbnail yet (an encounter uses sword) *@
        case "map":
            <path d="M20.5 3l-.16.03L15 5.1 9 3 3.36 4.9c-.21.07-.36.25-.36.48V20.5a.5.5 0 0 0 .5.5l.16-.03L9 18.9l6 2.1 5.64-1.9c.21-.07.36-.25.36-.48V3.5a.5.5 0 0 0-.5-.5zM15 19l-6-2.11V5l6 2.11V19z" />
            break;
        case "palette":
            <path d="M12 3a9 9 0 0 0 0 18c.83 0 1.5-.67 1.5-1.5 0-.39-.15-.74-.39-1.01-.23-.26-.38-.61-.38-.99 0-.83.67-1.5 1.5-1.5H16c2.76 0 5-2.24 5-5 0-4.42-4.03-8-9-8zm-5.5 9a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3zm3-4a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3zm5 0a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3zm3 4a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3z" />
            break;

        case "back":
            <path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z" />
            break;
    }
</svg>

@code {
    /// <summary>
    /// heart, shield, magic, divine or sword, or the canvas tools: pen, eraser, move, token, text, image, shapes (and rect, ellipse, line, arrow), undo and back; or the scene kind map.
    /// </summary>
    [Parameter, EditorRequired]
    public string Name { get; set; } = string.Empty;
}
