@namespace DungeonWorldBot.Dashboard.Components
@using DungeonWorldBot.Features.Classes
@* One move on a reference page, marked when the character being looked at has it or could take it now *@
<ExpandableItem Name="@Move.Name" Preview="@Move.Summary" Class="@(Has ? "owned" : null)">
    <Chips>
        @if (Label is not null)
        {
            <Chip>@Label</Chip>
        }
        @if (Move.Requires is { } requires)
        {
            <Chip Title="@($"Needs {requires} first")">Needs @requires</Chip>
        }
        @if (Move.Replaces is { } replaces)
        {
            <Chip>Replaces @replaces</Chip>
        }
        @if (Move.GrantsSpells is { } spells)
        {
            <Chip Kind="class" Href="@($"{Lookup.SpellsUrl(ForCharacter)}#{spells.List.ToString().ToLower()}")">@spells.List spells →</Chip>
        }
        @if (Move.Uses is { } uses)
        {
            <Chip>@Plural(uses, "use")</Chip>
        }
        @if (Has)
        {
            <Chip Kind="good">✓ Has</Chip>
        }
        else if (CanTake)
        {
            <Chip Kind="accent">Can take</Chip>
        }
    </Chips>
</ExpandableItem>

@code {
    [Parameter, EditorRequired]
    public ClassMove Move { get; set; } = null!;

    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public bool Has { get; set; }

    [Parameter]
    public bool CanTake { get; set; }

    /// <summary>
    /// The character the page is showing, carried into links so the spell list marks their spells.
    /// </summary>
    [Parameter]
    public string? ForCharacter { get; set; }
}
