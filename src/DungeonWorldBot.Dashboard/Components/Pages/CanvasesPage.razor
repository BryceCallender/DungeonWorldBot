@page "/scenes"
@* The old address, so links already shared in Discord still work *@
@page "/canvases"
@using DungeonWorldBot.Dashboard.Canvases
@using Microsoft.AspNetCore.Components.Forms
@inject CanvasStore CanvasStore
@inject CanvasPresence Presence
@inject Viewer Viewer

<PageTitle>Scenes · Sana Solem</PageTitle>

<div class="canvases-head">
    <h1>@(Archived ? "Archived scenes" : "Scenes")</h1>

    @if (!Archived)
    {
        @* Plain links, filtered on the server, so they need no script *@
        <nav class="canvas-filters" aria-label="Show">
            <a class="chip@(_kind is null ? " on" : "")" href="scenes">All</a>
            @foreach (var kind in Enum.GetValues<CanvasKind>())
            {
                <a class="chip@(_kind == kind ? " on" : "")" href="scenes?kind=@kind">@Plural(kind)</a>
            }
        </nav>

        <button type="button" class="tool new-canvas" data-open-dialog="new-scene">+ New scene</button>

        @* Opened by app.js; it opens straight away when the server sent back a mistake in the name *@
        <dialog id="new-scene" class="modal" aria-labelledby="new-scene-title" data-open-on-load="@(Error is not null ? "true" : null)">
            <form method="post" action="api/canvases">
                <AntiforgeryToken />
                <div class="modal-head">
                    <h2 id="new-scene-title">New scene</h2>
                    <button type="button" class="modal-close" data-close-dialog aria-label="Close">×</button>
                </div>

                <label class="field">
                    <span class="field-label">Name</span>
                    <input class="filter" name="name" maxlength="@CanvasStore.MaxNameLength" placeholder="Goblin ambush at the ford" required autofocus />
                    @if (Error == "name")
                    {
                        <span class="form-error">Give it a name, up to @CanvasStore.MaxNameLength letters.</span>
                    }
                </label>

                <fieldset class="kind-options">
                    <legend class="field-label">Kind</legend>
                    @foreach (var kind in Enum.GetValues<CanvasKind>())
                    {
                        <label class="kind-option">
                            <input type="radio" name="kind" value="@kind" checked="@(kind == (_kind ?? CanvasKind.Encounter))" />
                            <span class="kind-icon @KindClass(kind)"><Icon Name="@KindIcon(kind)" /></span>
                            <span class="kind-text">
                                <strong>@kind</strong>
                                <span class="small muted">@KindDescription(kind)</span>
                            </span>
                        </label>
                    }
                </fieldset>

                <div class="modal-actions">
                    <button type="button" class="tool" data-close-dialog>Cancel</button>
                    <button class="tool create">Create</button>
                </div>
            </form>
        </dialog>
    }
    else
    {
        <a class="tool" href="scenes">← Back to scenes</a>
    }
</div>

@if (_canvasList.Count == 0)
{
    <p class="empty">
        @if (Archived) { <text>Nothing's been put away.</text> }
        else if (_kind is { } kind) { <text>No @Plural(kind).ToLowerInvariant() yet.</text> }
        else { <text>No scenes yet. Make one for your next encounter or map.</text> }
    </p>
}
else
{
    <div class="canvas-grid">
        @foreach (var c in _canvasList)
        {
            var sqid = CanvasIds.Encode(c.ID);
            var peopleOnCanvas = Presence.On(c.ID);

            <article class="canvas-card">
                <a class="canvas-link" href="scene/@sqid">
                    <div class="canvas-thumbnail">
                        @if (_thumbnails.TryGetValue(c.ID, out var taken))
                        {
                            @* The time it was taken is in the URL, so a new picture gets a new address *@
                            <img src="api/canvases/@sqid/thumbnail?v=@taken.Ticks" alt="" loading="lazy" />
                        }
                        else
                        {
                            <span class="canvas-placeholder"><Icon Name="@KindIcon(c.Kind)" /></span>
                        }
                        @if (peopleOnCanvas.Count > 0)
                        {
                            <span class="here" title="@string.Join(", ", peopleOnCanvas.Select(p => p.Name))">● @peopleOnCanvas.Count here</span>
                        }
                    </div>
                    <span class="canvas-name">@c.Name</span>
                </a>

                <div class="canvas-description">
                    <span class="chip @KindClass(c.Kind)"><Icon Name="@KindIcon(c.Kind)" /> @c.Kind</span>
                    @* Shown as "2 minutes ago" by app.js, in the viewer's own time zone *@
                    <time datetime="@DateTime.SpecifyKind(c.UpdatedAt, DateTimeKind.Utc).ToString("o")" data-ago>@c.UpdatedAt.ToString("MMM d")</time>

                    @if (CanPutAway(c))
                    {
                        <form method="post" action="api/canvases/@sqid/@(Archived ? "restore" : "archive")" class="canvas-action">
                            <AntiforgeryToken />
                            <button class="link-button" title="@(Archived ? "Bring it back to the list" : "Hide it from the list; it's kept")">@(Archived ? "Restore" : "Archive")</button>
                        </form>

                        @if (Archived)
                        {
                            <button type="button" class="link-button delete" data-open-dialog="delete-@sqid" title="Delete it for good">Delete</button>

                            <dialog id="delete-@sqid" class="modal" aria-labelledby="delete-@sqid-title">
                                <form method="post" action="api/canvases/@sqid/delete">
                                    <AntiforgeryToken />
                                    <div class="modal-head">
                                        <h2 id="delete-@sqid-title">Delete @c.Name?</h2>
                                        <button type="button" class="modal-close" data-close-dialog aria-label="Close">×</button>
                                    </div>

                                    <p class="muted">Everything drawn on it and every picture added to it goes too. This can't be undone.</p>

                                    <div class="modal-actions">
                                        <button type="button" class="tool" data-close-dialog>Cancel</button>
                                        <button class="tool destroy">Delete</button>
                                    </div>
                                </form>
                            </dialog>
                        }
                    }
                </div>
            </article>
        }
    </div>
}

@if (!Archived && _archivedCount > 0)
{
    <p class="archived-link"><a href="scenes?archived=true">Archived (@_archivedCount)</a></p>
}

@code {
    [SupplyParameterFromQuery] public string? Kind { get; set; }
    [SupplyParameterFromQuery] public bool Archived { get; set; }
    [SupplyParameterFromQuery] public string? Error { get; set; }

    private IReadOnlyList<Canvas> _canvasList = [];
    private Dictionary<int, DateTime> _thumbnails = [];
    private int _archivedCount;
    private CanvasKind? _kind;

    protected override async Task OnInitializedAsync()
    {
        _kind = Enum.TryParse<CanvasKind>(Kind, ignoreCase: true, out var kind) ? kind : null;

        var all = await CanvasStore.ListAsync(Archived);
        _canvasList = _kind is null ? all : all.Where(c => c.Kind == _kind).ToList();
        _thumbnails = await CanvasStore.ThumbnailTimesAsync();
        _archivedCount = Archived ? 0 : await CanvasStore.CountArchivedAsync();
    }

    // The same rule as the archive endpoint: the DM, whoever made it, or anyone when sign-in is off
    private bool CanPutAway(Canvas canvas) =>
        !Viewer.SignedIn || Viewer.IsDungeonMaster || Viewer.Is(canvas.CreatedBy ?? "");

    private static string Plural(CanvasKind kind) => $"{kind}s";

    private static string KindIcon(CanvasKind kind) => kind switch
    {
        CanvasKind.Encounter => "sword",
        _ => "map",
    };

    private static string KindDescription(CanvasKind kind) => kind switch
    {
        CanvasKind.Encounter => "A board for a fight, which shows beside it while it's going on.",
        _ => "A place to explore, or anything else worth drawing out.",
    };

    private static string KindClass(CanvasKind kind) => kind switch
    {
        CanvasKind.Encounter => "warn",
        _ => "good",
    };
}
