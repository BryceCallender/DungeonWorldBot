@page "/classes/{Name}"
@using DungeonWorldBot.Features.Classes
@using DungeonWorldBot.Features.Rolls
@inject PartyReader PartyReader
@inject Viewer Viewer

@if (_sheet is not { } sheet)
{
    <PageTitle>Not found · Sana Solem</PageTitle>
    <p class="empty">No class called that. <a href="classes">All classes</a></p>
    return;
}

<PageTitle>@PartyReader.ClassName(sheet.Type) · Sana Solem</PageTitle>

<a class="back" href="classes">← Classes</a>

<div data-filter-scope>
    <header class="card hero @Lookup.ColorOf(sheet.Type)">
        <div class="hero-main">
            <h1 class="class-name">@PartyReader.ClassName(sheet.Type)</h1>
            <div class="muted">@sheet.Source</div>
            @if (_character is { } who)
            {
                <div class="hero-chips">
                    <span class="chip accent">Showing @who.Name's moves · level @who.Level</span>
                    <a class="small" href="@Lookup.ClassUrl(sheet.Type)">Clear</a>
                </div>
            }
            else if (_players.Count > 0)
            {
                <div class="small bonds">
                    Show moves for
                    @for (var i = 0; i < _players.Count; i++)
                    {
                        var p = _players[i];
                        <a href="@Lookup.ClassUrl(sheet.Type, p.Slug)">@p.Name</a>@(i < _players.Count - 1 ? ", " : "")
                    }
                </div>
            }
        </div>
        <div class="hero-vitals">
            <div class="vital heart">
                <span class="tile-label"><Icon Name="heart" />HP</span>
                <strong>@_basics.BaseHP + CON</strong>
            </div>
            <div class="vital damage">
                <span class="tile-label"><Icon Name="sword" />Damage</span>
                <strong>@_basics.Damage</strong>
            </div>
            <div class="vital armor">
                <span class="tile-label"><Icon Name="shield" />Armor</span>
                <strong>@(_kit?.BaseArmor ?? 0)</strong>
                <span class="small">before gear</span>
            </div>
            @if (_character is { } c)
            {
                <div class="vital">
                    <span class="tile-label">Advances</span>
                    <strong>@sheet.AdvancesTaken(_known) / @Math.Max(0, c.Level - 1)</strong>
                    <span class="small">taken</span>
                </div>
            }
        </div>
    </header>

    <nav class="jump">
        <a href="@Here#starting">Starting</a>
        @foreach (var feature in sheet.Features)
        {
            <a href="@Here#@Lookup.Slug(feature.Name)">@feature.Name</a>
        }
        <a href="@Here#level-2">Levels 2–5</a>
        <a href="@Here#level-6">Levels 6–10</a>
        @if (sheet.Extras.Count > 0)
        {
            <a href="@Here#extras">Extras</a>
        }
        @if (sheet.Resources.Count > 0)
        {
            <a href="@Here#resources">Resources</a>
        }
        @if (_kit is not null)
        {
            <a href="@Here#gear">Starting gear</a>
        }
        <input type="search" class="filter jump-filter" placeholder="Search this class…" aria-label="Search this class" data-filter />
    </nav>

    <div class="sheet">
        <section class="card wide" id="starting" data-filter-group>
            <div class="card-head">
                <h2>Starting moves</h2>
                <button type="button" class="tool" data-expand>Expand all</button>
            </div>
            <ul class="moves">
                @foreach (var move in sheet.StartingMoves)
                {
                    <MoveItem Move="move" Has="Has(move)" ForCharacter="@_character?.Slug" />
                }
                @if (sheet.DeathMove is { } death)
                {
                    <MoveItem Move="death" Label="Death move" Has="Has(death)" ForCharacter="@_character?.Slug" />
                }
            </ul>
        </section>

        @foreach (var feature in sheet.Features)
        {
            <section class="card wide" id="@Lookup.Slug(feature.Name)" data-filter-group>
                <div class="card-head">
                    <div>
                        <h2>@feature.Name</h2>
                        <div class="muted">@ToHtml(feature.Prompt) · choose @feature.Picks@(feature.LaterPicksAreAdvances ? ", more later as advances" : "")</div>
                    </div>
                    <button type="button" class="tool" data-expand>Expand all</button>
                </div>
                <ul class="moves">
                    @foreach (var option in feature.Options)
                    {
                        <MoveItem Move="option" Has="Has(option)" CanTake="CanTake(option)" ForCharacter="@_character?.Slug" />
                    }
                </ul>
            </section>
        }

        @foreach (var (id, title, moves) in Tiers(sheet))
        {
            <section class="card wide" id="@id" data-filter-group>
                <div class="card-head">
                    <h2>@title <span class="small">· @moves.Count</span></h2>
                    <button type="button" class="tool" data-expand>Expand all</button>
                </div>
                <ul class="moves">
                    @foreach (var move in moves)
                    {
                        <MoveItem Move="move" Has="Has(move)" CanTake="CanTake(move)" ForCharacter="@_character?.Slug" />
                    }
                </ul>
            </section>
        }

        @if (sheet.Resources.Count > 0)
        {
            <section class="card wide" id="resources" data-filter-group>
                <h2>Resources</h2>
                <ul class="moves">
                    @foreach (var resource in sheet.Resources)
                    {
                        <li>
                            <div class="move-name">
                                @resource.Name
                                <span class="chip">Starts at @resource.Start</span>
                                @if (resource.Max is { } max)
                                {
                                    <span class="chip">Max @max</span>
                                }
                                @if (resource.GrantedBy is { } grantedBy)
                                {
                                    <span class="chip">From @grantedBy</span>
                                }
                            </div>
                            <div class="small">@ToHtml(resource.Summary)</div>
                        </li>
                    }
                </ul>
            </section>
        }

        @if (_kit is { } kit)
        {
            <section class="card wide" id="gear">
                <h2>Starting gear</h2>
                @if (_baseItems.Count > 0)
                {
                    <div class="muted">Everyone starts with</div>
                    <div class="resource-chips kit-base">
                        @foreach (var item in _baseItems)
                        {
                            <span class="chip">@item</span>
                        }
                    </div>
                }
                @foreach (var question in kit.Questions)
                {
                    <h3>@question.Prompt @if (question.Picks > 1) { <span class="small">· choose @question.Picks</span> }</h3>
                    <ul class="plain kit-choices">
                        @foreach (var choice in question.Choices)
                        {
                            <li>
                                @choice.Label
                                @if (choice.Armor != 0)
                                {
                                    <span class="chip">@Signed(choice.Armor) armor</span>
                                }
                                @if (choice.Damage != 0)
                                {
                                    <span class="chip">@Signed(choice.Damage) damage</span>
                                }
                            </li>
                        }
                    </ul>
                }
            </section>
        }
    </div>

    <p class="empty no-matches" hidden>Nothing in this class matches.</p>
</div>

@code {
    [Parameter]
    public string Name { get; set; } = string.Empty;

    /// <summary>
    /// A character whose moves to mark, by ID. Defaults to the viewer's own character when it's this class.
    /// </summary>
    [SupplyParameterFromQuery(Name = "for")]
    public string? For { get; set; }

    private ClassSheet? _sheet;
    private (string Damage, int BaseHP) _basics;
    private DungeonWorldBot.Features.Characters.Creation.ClassKit? _kit;
    private List<string> _baseItems = [];
    private CharacterView? _character;
    private IReadOnlyCollection<string> _known = [];
    private List<CharacterView> _players = [];

    private string Here => Lookup.ClassUrl(_sheet!.Type, For);

    protected override async Task OnParametersSetAsync()
    {
        _sheet = Lookup.FindClass(Name);
        if (_sheet is null)
            return;

        _basics = Lookup.Basics(_sheet.Type);
        _kit = Lookup.Kit(_sheet.Type);
        // Base kit items are fixed, so rolling them only names them
        _baseItems = (_kit?.BaseItems ?? [])
            .Select(grant => grant.Create(new DiceRoller()))
            .Select(item => item.Amount > 1 ? $"{item.Name} ×{item.Amount}" : item.Name)
            .ToList();

        var party = await PartyReader.GetPartyAsync();
        _players = party.Where(c => c.Character.Class.Type == _sheet.Type).ToList();

        _character = For is not null
            ? PartyReader.Match(party, For)
            : _players.FirstOrDefault(c => Viewer.Is(c.ID));
        _known = _character is null ? [] : ClassSheetLibrary.KnownMoves(_character.Character);
    }

    private bool Has(ClassMove move) => _known.Contains(move.Name, StringComparer.OrdinalIgnoreCase);

    // Only meaningful for the character's own class; other classes' moves come through multiclassing rules instead
    private bool CanTake(ClassMove move) =>
        _character is { } c
        && c.Character.Class.Type == _sheet!.Type
        && _sheet.WhyCannotLearn(move, c.Level, _known) is null;

    private static IEnumerable<(string Id, string Title, List<ClassMove> Moves)> Tiers(ClassSheet sheet)
    {
        yield return ("level-2", "Levels 2–5", sheet.AdvancedMoves.Where(m => m.Tier == MoveTier.Level2To5).ToList());
        yield return ("level-6", "Levels 6–10", sheet.AdvancedMoves.Where(m => m.Tier == MoveTier.Level6To10).ToList());
        if (sheet.Extras.Count > 0)
            yield return ("extras", "Extras", sheet.Extras.ToList());
    }
}
