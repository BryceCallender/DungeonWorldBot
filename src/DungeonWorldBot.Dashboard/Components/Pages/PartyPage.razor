@page "/"
@inject PartyReader PartyReader
@inject DashboardSettings Settings
@inject Viewer Viewer

<PageTitle>Party · Sana Solem</PageTitle>

<h1>Party</h1>

@if (_party.Count == 0)
{
    <p class="empty">No characters yet. Make one in Discord with /character create.</p>
}
else
{
    var hp = _party.Sum(c => c.CurrentHP);
    var maxHp = _party.Sum(c => c.MaxHP);
    <div class="tiles">
        <div class="card tile">
            <span class="tile-label">Party HP</span>
            <strong>@hp / @maxHp</strong>
            <span class="small">@(maxHp == 0 ? 0 : hp * 100 / maxHp)%</span>
        </div>
        <div class="card tile">
            <span class="tile-label">Hurt</span>
            <strong>@_party.Count(c => c.CurrentHP < c.MaxHP)</strong>
            <span class="small">@_party.Count(c => c.HealthPercent <= 25) critical</span>
        </div>
        <div class="card tile">
            <span class="tile-label">Average level</span>
            <strong>@_party.Average(c => c.Level).ToString("0.#")</strong>
        </div>
        <div class="card tile">
            <span class="tile-label">Coin</span>
            <strong>@_party.Sum(Coin)</strong>
            <span class="small">across the party</span>
        </div>
        <div class="card tile">
            <span class="tile-label">Debilities</span>
            <strong>@_party.Sum(c => c.Debilitated.Count)</strong>
        </div>
        <div class="card tile">
            <span class="tile-label">Unspent stat points</span>
            <strong>@_party.Sum(c => c.StatPoints)</strong>
        </div>
    </div>

    <div class="party">
        @foreach (var c in _party)
        {
            <a class="card member @Lookup.ColorOf(c.Character.Class.Type)" href="@c.Url">
                <div class="member-head">
                    <div>
                        <h2>@c.Name @if (Viewer.Is(c.ID)) { <span class="chip accent">You</span> }</h2>
                        <div class="muted class-line">
                            <span>Level @c.Level <span class="class-name">@c.ClassName</span></span>
                            @if (c.Subclass is { } sub)
                            {
                                <span class="chip accent" title="@sub.Name">@sub.Name</span>
                            }
                        </div>
                    </div>
                    @if (c.Character.Status is { } status && status != Status.Alive)
                    {
                        <span class="chip warn">@status</span>
                    }
                </div>

                @* The same for everyone, so these line up across cards *@
                <HealthBar View="c" />

                <div class="armor-row">
                    <span title="Physical armor"><Icon Name="shield" />@c.Armor.Physical</span>
                    <span title="Magical armor"><Icon Name="magic" />@c.Armor.Magical</span>
                    @if (c.Armor.Divine != 0)
                    {
                        <span title="Divine armor"><Icon Name="divine" />@c.Armor.Divine</span>
                    }
                    <span title="Damage"><Icon Name="sword" />@c.Damage</span>
                </div>

                <StatGrid Stats="c.Stats" />

                @* What only some characters have *@
                @if (c.Subclass?.Status is not null || ActiveShapes(c).Count > 0 || c.Resources.Count > 0 || c.StatPoints > 0)
                {
                    <div class="member-extra">
                        @if (c.Subclass?.Status is { } subclassStatus)
                        {
                            <div class="small">@ToHtml(subclassStatus)</div>
                        }

                        @if (ActiveShapes(c) is { Count: > 0 } shapes)
                        {
                            <div class="small">🐾 In the shape of <strong>@string.Join(" + ", shapes)</strong></div>
                        }

                        @if (c.Resources.Count > 0 || c.StatPoints > 0)
                        {
                            <div class="resource-chips">
                                @foreach (var r in c.Resources)
                                {
                                    <span class="chip class" title="@r.Summary">@r.Name @r.Value@(r.Max is { } max ? $"/{max}" : "")</span>
                                }
                                @if (c.StatPoints > 0)
                                {
                                    <span class="chip accent">@c.StatPoints stat point@(c.StatPoints == 1 ? "" : "s")</span>
                                }
                            </div>
                        }
                    </div>
                }

                <div class="member-foot small">
                    @if (Settings.TrackWeight && c.Character.Inventory is { MaxLoad: > 0 } inventory)
                    {
                        <span>🎒 @inventory.CurrentLoad/@inventory.MaxLoad load</span>
                    }
                    else
                    {
                        <span>🎒 @(c.Character.Inventory?.Items?.Count ?? 0) items</span>
                    }
                    <span>🪙 @Coin(c)</span>
                    <span>🔗 @(c.Character.Bonds?.Count ?? 0) bonds</span>
                </div>
            </a>
        }
    </div>
}

@if (_npcs.Count > 0)
{
    <h2 class="section-title">Companions</h2>
    <div class="party">
        @foreach (var npc in _npcs)
        {
            <div class="card member npc">
                <div class="member-head">
                    <div>
                        <h2>@npc.Name</h2>
                        <div class="muted class-line">
                            <span>@(npc.Role ?? "NPC")</span>
                            @if (Follows(npc) is { } leader)
                            {
                                <span class="chip accent">follows @leader</span>
                            }
                        </div>
                    </div>
                    @if (npc.CurrentHP == 0)
                    {
                        <span class="chip warn">Down</span>
                    }
                </div>

                <HealthBar Current="npc.CurrentHP" Max="npc.MaxHP" />

                <div class="armor-row">
                    <span title="Armor"><Icon Name="shield" />@npc.Armor</span>
                    @if (npc.Damage is not null)
                    {
                        <span title="Damage"><Icon Name="sword" />@npc.Damage</span>
                    }
                    <span title="Loyalty">Loyalty @Signed(npc.Loyalty)</span>
                </div>

                @* Modifiers only: NPCs don't have scores *@
                <div class="stats">
                    @foreach (var stat in Enum.GetValues<StatType>())
                    {
                        <div class="stat">
                            <span class="stat-name">@stat.ToString().ToUpper()</span>
                            <span class="stat-mod">@Signed(npc.Modifier(stat))</span>
                        </div>
                    }
                </div>

                @if (npc.Skills is not null || npc.Cost is not null || npc.Notes is not null)
                {
                    <div class="member-extra small">
                        @if (npc.Skills is not null)
                        {
                            <div><strong>Skills</strong> @npc.Skills</div>
                        }
                        @if (npc.Cost is not null)
                        {
                            <div><strong>Cost</strong> @npc.Cost</div>
                        }
                        @if (npc.Notes is not null)
                        {
                            <div class="muted">@npc.Notes</div>
                        }
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    private IReadOnlyList<CharacterView> _party = [];
    private IReadOnlyList<Npc> _npcs = [];

    protected override async Task OnInitializedAsync()
    {
        _party = await PartyReader.GetPartyAsync();
        _npcs = await PartyReader.GetNpcsAsync();
    }

    // The name of the character they follow, if that player has one
    private string? Follows(Npc npc) =>
        npc.FollowsID is { } id ? PartyReader.Match(_party, id.Value.ToString())?.Name : null;

    private static List<string> ActiveShapes(CharacterView c) =>
        (c.Character.Transformations ?? []).Where(f => f.IsActive).Select(f => f.Name).ToList();

    // Kits have called it both "Coin" and "Coins"
    private static int Coin(CharacterView c) =>
        (c.Character.Inventory?.Items ?? [])
            .Where(i => i.Name.StartsWith("Coin", StringComparison.OrdinalIgnoreCase))
            .Sum(i => i.Amount);
}
