@page "/npcs"
@using DungeonWorldBot.Dashboard.Encounters
@using DungeonWorldBot.Dashboard.Npcs
@using DungeonWorldBot.Features.Characters
@inject PartyReader PartyReader
@inject ICharacterService Characters
@inject Viewer Viewer

@* The DM's tab for the NPCs travelling with the party: everything /dm npc does in Discord, as plain forms. A mistake
   comes back in the address and reopens its dialog, or shows at the top for the quick HP buttons. *@
<PageTitle>NPCs · Sana Solem</PageTitle>

<div class="desk-head">
    <h1>NPCs</h1>
    @if (_canRun)
    {
        <button type="button" class="tool desk-new" data-open-dialog="npc-new">+ New NPC</button>
    }
</div>

@if (!_canRun)
{
    <p class="empty">Only the DM looks after NPCs here. You can see the party's on the <a href="">Party</a> page.</p>
}
else
{
    @if (Error is { } error && Dialog is null)
    {
        <p class="form-error desk-error">@error</p>
    }

    @if (_npcs.Count == 0)
    {
        <p class="empty">No NPCs are with the party yet.</p>
    }
    else
    {
        <div class="desk-grid">
            @foreach (var npc in _npcs)
            {
                @NpcCard(npc)
            }
        </div>
    }

    <dialog id="npc-new" class="modal" aria-labelledby="npc-new-title" data-open-on-load="@OpenOnLoad("npc-new")">
        <form method="post" action="api/npcs">
            <AntiforgeryToken />
            <div class="modal-head">
                <h2 id="npc-new-title">New NPC</h2>
                <button type="button" class="modal-close" data-close-dialog aria-label="Close">×</button>
            </div>
            @Fields(null)
            @ErrorFor("npc-new")
            <div class="modal-actions">
                <button type="button" class="tool" data-close-dialog>Cancel</button>
                <button class="tool create">Add to the party</button>
            </div>
        </form>
    </dialog>

    @foreach (var npc in _npcs)
    {
        <dialog id="npc-edit-@npc.ID" class="modal" aria-labelledby="npc-edit-@npc.ID-title" data-open-on-load="@OpenOnLoad($"npc-edit-{npc.ID}")">
            <form method="post" action="api/npcs/@npc.ID">
                <AntiforgeryToken />
                <div class="modal-head">
                    <h2 id="npc-edit-@npc.ID-title">@npc.Name</h2>
                    <button type="button" class="modal-close" data-close-dialog aria-label="Close">×</button>
                </div>
                @Fields(npc)
                @ErrorFor($"npc-edit-{npc.ID}")
                <div class="modal-actions">
                    <button type="button" class="tool" data-close-dialog>Cancel</button>
                    <button class="tool create">Save</button>
                </div>
            </form>
        </dialog>

        <dialog id="npc-remove-@npc.ID" class="modal" aria-labelledby="npc-remove-@npc.ID-title">
            <form method="post" action="api/npcs/@npc.ID/remove">
                <AntiforgeryToken />
                <div class="modal-head">
                    <h2 id="npc-remove-@npc.ID-title">Send @npc.Name away?</h2>
                    <button type="button" class="modal-close" data-close-dialog aria-label="Close">×</button>
                </div>
                <p class="small muted">They leave the party and any fight they're in. What they did in fights stays in its spotlight.</p>
                <div class="modal-actions">
                    <button type="button" class="tool" data-close-dialog>Keep them</button>
                    <button class="tool create danger">Send away</button>
                </div>
            </form>
        </dialog>
    }
}

@code {
    // Set by the forms when something was wrong: the dialog to reopen, and what to say in it
    [SupplyParameterFromQuery] public string? Dialog { get; set; }
    [SupplyParameterFromQuery] public string? Error { get; set; }

    private bool _canRun;
    private IReadOnlyList<Npc> _npcs = [];
    private IReadOnlyList<Character> _characters = [];

    protected override async Task OnInitializedAsync()
    {
        _canRun = EncounterEndpoints.CanRun(Viewer);
        if (!_canRun)
            return;

        _npcs = await PartyReader.GetNpcsAsync();
        _characters = (await Characters.GetCharactersAsync()).OrderBy(c => c.Name).ToList();
    }

    private string? OpenOnLoad(string dialog) => Error is not null && Dialog == dialog ? "true" : null;

    private RenderFragment? ErrorFor(string dialog) =>
        Error is { } error && Dialog == dialog ? @<p class="form-error">@error</p> : null;

    private RenderFragment NpcCard(Npc npc) =>
    @<div class="card desk-card" id="npc-@npc.ID">
        <div class="member-head">
            <div>
                <h2>@npc.Name</h2>
                <div class="muted desk-line">
                    <span>@(npc.Role ?? "NPC")</span>
                    @if (Follows(npc) is { } leader)
                    {
                        <span class="chip accent">follows @leader</span>
                    }
                </div>
            </div>
            @if (npc.CurrentHP == 0)
            {
                <span class="chip warn">Down</span>
            }
        </div>

        <HealthBar Current="npc.CurrentHP" Max="npc.MaxHP" />
        <HpChangeForm Action="@($"api/npcs/{npc.ID}/hp")" Name="@npc.Name" />

        <div class="desk-stats">
            <span title="Armor"><Icon Name="shield" />@npc.Armor</span>
            @if (npc.Damage is not null)
            {
                <span title="Damage"><Icon Name="sword" />@npc.Damage</span>
            }
            <span title="Loyalty">Loyalty @Signed(npc.Loyalty)</span>
        </div>

        <div class="stats">
            @foreach (var stat in Enum.GetValues<StatType>())
            {
                <div class="stat">
                    <span class="stat-name">@stat.ToString().ToUpper()</span>
                    <span class="stat-mod">@Signed(npc.Modifier(stat))</span>
                </div>
            }
        </div>

        @if (npc.Skills is not null || npc.Cost is not null || npc.Notes is not null)
        {
            <div class="desk-extra small">
                @if (npc.Skills is not null)
                {
                    <div><strong>Skills</strong> @npc.Skills</div>
                }
                @if (npc.Cost is not null)
                {
                    <div><strong>Cost</strong> @npc.Cost</div>
                }
                @if (npc.Notes is not null)
                {
                    <div class="muted desk-notes">@npc.Notes</div>
                }
            </div>
        }

        <div class="desk-actions">
            <button type="button" class="tool" data-open-dialog="npc-edit-@npc.ID">Edit</button>
            <button type="button" class="tool" data-open-dialog="npc-remove-@npc.ID">Send away</button>
        </div>
    </div>;

    /// <summary>
    /// Everything about an NPC, filled in with what they have now, or blank for a new one.
    /// </summary>
    private RenderFragment Fields(Npc? npc) =>
    @<div class="desk-fields">
        <div class="field-row">
            <label class="field">
                <span class="field-label">Name</span>
                <input class="filter" name="name" value="@npc?.Name" maxlength="@NpcDesk.MaxNameLength" placeholder="Bram" required />
            </label>
            <label class="field">
                <span class="field-label">Role</span>
                <input class="filter" name="role" value="@npc?.Role" maxlength="@NpcDesk.MaxNameLength" placeholder="Hireling" />
            </label>
        </div>
        <div class="field-row">
            @if (npc is not null)
            {
                <label class="field">
                    <span class="field-label">HP</span>
                    <input class="filter" type="number" name="currentHp" value="@npc.CurrentHP" min="0" required />
                </label>
            }
            <label class="field">
                <span class="field-label">Max HP</span>
                <input class="filter" type="number" name="maxHp" value="@npc?.MaxHP" min="1" placeholder="6" required />
            </label>
            <label class="field">
                <span class="field-label">Armor</span>
                <input class="filter" type="number" name="armor" value="@(npc?.Armor ?? 0)" min="0" />
            </label>
            <label class="field">
                <span class="field-label">Damage</span>
                <input class="filter" name="damage" value="@npc?.Damage" maxlength="@NpcDesk.MaxNameLength" placeholder="d6" />
            </label>
            <label class="field">
                <span class="field-label">Loyalty</span>
                <input class="filter" type="number" name="loyalty" value="@(npc?.Loyalty ?? 0)" />
            </label>
        </div>
        <fieldset class="desk-modifiers">
            <legend class="field-label">Modifiers</legend>
            @foreach (var stat in Enum.GetValues<StatType>())
            {
                <label class="field">
                    <span class="field-label">@stat.ToString().ToUpper()</span>
                    <input class="filter" type="number" name="@stat.ToString().ToLowerInvariant()" value="@(npc?.Modifier(stat) ?? 0)"
                           min="-@NpcDesk.MaxModifier" max="@NpcDesk.MaxModifier" />
                </label>
            }
        </fieldset>
        <label class="field">
            <span class="field-label">Skills</span>
            <input class="filter" name="skills" value="@npc?.Skills" maxlength="@NpcDesk.MaxTextLength" placeholder="Protector +2, Tracker +1" />
        </label>
        <div class="field-row">
            <label class="field">
                <span class="field-label">Cost</span>
                <input class="filter" name="cost" value="@npc?.Cost" maxlength="@NpcDesk.MaxNameLength" placeholder="Money" />
            </label>
            <label class="field">
                <span class="field-label">Follows</span>
                <select class="filter" name="follows">
                    <option value="">Nobody in particular</option>
                    @foreach (var character in _characters)
                    {
                        <option value="@character.ID.Value" selected="@(npc?.FollowsID == character.ID)">@character.Name</option>
                    }
                </select>
            </label>
        </div>
        <label class="field">
            <span class="field-label">Notes</span>
            <textarea class="filter" name="notes" maxlength="@NpcDesk.MaxTextLength">@npc?.Notes</textarea>
        </label>
    </div>;

    // The name of the character they follow, if that player has one
    private string? Follows(Npc npc) =>
        npc.FollowsID is { } id ? _characters.FirstOrDefault(c => c.ID == id)?.Name : null;
}
