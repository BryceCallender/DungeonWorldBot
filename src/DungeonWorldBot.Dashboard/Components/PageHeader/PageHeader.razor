@namespace DungeonWorldBot.Dashboard.Components
@* The top of a list page: its title, anything that sits beside it (like filters), its buttons at the right, and a line
   saying what the page is for *@
<header class="page-head">
    <h1>@Title</h1>
    @ChildContent
    @if (Actions is not null)
    {
        <div class="page-actions">@Actions</div>
    }
    @if (Description is not null)
    {
        <p class="muted">@Description</p>
    }
</header>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = "";

    [Parameter]
    public string? Description { get; set; }

    /// <summary>
    /// What sits beside the title, like a scene list's filters.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// The page's buttons, like "+ New NPC", at the right.
    /// </summary>
    [Parameter]
    public RenderFragment? Actions { get; set; }
}
