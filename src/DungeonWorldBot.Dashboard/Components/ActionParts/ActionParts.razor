@namespace DungeonWorldBot.Dashboard.Components
@using DungeonWorldBot.Features.Encounters

@* Something someone did in a fight, in at most two lines: the move and who it was aimed at, then how the roll went (a
   pill in the outcome's colour) and what it did *@
<div class="action-parts" title="@Title">
    <div class="action-line">
        <span class="action">@Action.Action</span>
        @if (Action.Target is not null)
        {
            <span class="target">→ @Action.Target</span>
        }
    </div>
    @if (Action.Roll is not null || Action.Result is not null || Action.ChangedReason is not null)
    {
        <div class="outcome-line">
            @if (Action.Roll is not null)
            {
                <span class="roll-pill @FromRollText(Action.Roll, Action.Missed)">@ShortFightText(Action.Roll)</span>
            }
            @if (Action.Result is not null)
            {
                <span class="dmg">@ShortFightText(Action.Result)</span>
            }
            @if (Action.ChangedReason is not null)
            {
                <span class="changed">✏️ @Action.ChangedReason</span>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public SpotlightAction Action { get; set; } = null!;

    [Parameter]
    public string? Title { get; set; }
}
