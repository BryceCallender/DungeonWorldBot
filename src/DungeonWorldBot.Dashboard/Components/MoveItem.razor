@using DungeonWorldBot.Features.Classes
@* One move on a reference page, marked when the character being looked at has it or could take it now *@
<li class="@(Has ? "owned" : "")">
    <details data-key="@Move.Name">
        <summary>
            <span class="move-name">
                @Move.Name
                @if (Label is not null)
                {
                    <span class="chip">@Label</span>
                }
                @if (Move.Requires is { } requires)
                {
                    <span class="chip" title="Needs @requires first">Needs @requires</span>
                }
                @if (Move.Replaces is { } replaces)
                {
                    <span class="chip">Replaces @replaces</span>
                }
                @if (Move.GrantsSpells is { } spells)
                {
                    <a class="chip class" href="@Lookup.SpellsUrl(ForCharacter)#@spells.List.ToString().ToLower()">@spells.List spells →</a>
                }
                @if (Move.Uses is { } uses)
                {
                    <span class="chip">@uses use@(uses == 1 ? "" : "s")</span>
                }
                @if (Has)
                {
                    <span class="chip good">✓ Has</span>
                }
                else if (CanTake)
                {
                    <span class="chip accent">Can take</span>
                }
            </span>
            <span class="preview">@ToHtml(Move.Summary)</span>
        </summary>
        <div class="small">@ToHtml(Move.Summary)</div>
    </details>
</li>

@code {
    [Parameter, EditorRequired]
    public ClassMove Move { get; set; } = null!;

    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public bool Has { get; set; }

    [Parameter]
    public bool CanTake { get; set; }

    /// <summary>
    /// The character the page is showing, carried into links so the spell list marks their spells.
    /// </summary>
    [Parameter]
    public string? ForCharacter { get; set; }
}
