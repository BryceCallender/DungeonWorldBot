@using DungeonWorldBot.Dashboard.Sessions
@inject SessionReader Sessions

@* While a session's going on (/session start), a strip across the top of every page with how long it's been and how
   the dice are going, linking to the session's page. Before anyone's rolled, it reminds everyone where they left off. *@
@if (_current is { } s)
{
    <a class="session-bar" href="@s.Url">
        <span class="session-name"><i class="live-dot"></i>@s.Name</span>
        <span class="session-stat">⏱ <time datetime="@s.Session.StartedAt.ToString("o")" data-since>@Elapsed(s.Length)</time></span>
        @if (s.Recap.Rolls > 0)
        {
            <span class="session-stat">🎲 @s.Recap.Rolls roll@(s.Recap.Rolls == 1 ? "" : "s") · @(s.Recap.Hits * 100 / s.Recap.Rolls)% hit</span>
            @if (s.Recap.Natural12s > 0)
            {
                <span class="session-stat">✨ @s.Recap.Natural12s</span>
            }
            @if (s.Recap.Fights.Count > 0)
            {
                <span class="session-stat">⚔️ @s.Recap.Fights.Count fight@(s.Recap.Fights.Count == 1 ? "" : "s")</span>
            }
        }
        else if (_previous is { } p)
        {
            <span class="session-previously">
                Previously, in @p.Name@(p.Recap.Fights.Count > 0 ? $": {string.Join(", ", p.Recap.Fights)}" : "")
            </span>
        }
    </a>
}

@code {
    private SessionSummary? _current;
    private SessionSummary? _previous;

    protected override async Task OnInitializedAsync()
    {
        _current = await Sessions.GetCurrentAsync();
        if (_current is { Recap.Rolls: 0 } current)
            _previous = await Sessions.GetPreviousAsync(current);
    }

    // app.js keeps it counting
    public static string Elapsed(TimeSpan length) =>
        length.TotalHours >= 1 ? $"{(int)length.TotalHours}h {length.Minutes:00}m" : $"{Math.Max(0, length.Minutes)}m";
}
