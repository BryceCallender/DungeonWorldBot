@inherits LayoutComponentBase
@inject Viewer Viewer
@inject NavigationManager Nav
@using DungeonWorldBot.Dashboard.Encounters

<header class="topbar">
    <a class="brand" href=""><span aria-hidden="true">🎲</span>Sana Solem</a>
    <nav>
        <NavLink href="" Match="NavLinkMatch.All" class="@ActiveFor("character/")">Party</NavLink>
        @* The DM's own tabs, for looking after who the party meets *@
        @if (EncounterEndpoints.CanRun(Viewer))
        {
            <NavLink href="npcs">NPCs</NavLink>
            <NavLink href="enemies">Enemies</NavLink>
        }
        <NavLink href="stats">Roll stats</NavLink>
        <NavLink href="classes">Classes</NavLink>
        <NavLink href="spells">Spells</NavLink>
        <NavLink href="moves">Moves</NavLink>
        <NavLink href="scenes" class="@ActiveFor("scene/", "canvas/")">Scenes</NavLink>
    </nav>

    <div class="viewer">
        <span class="live" title="Connecting…"><i class="live-dot off"></i>Live</span>
        @if (Viewer.SignedIn)
        {
            @if (!Viewer.IsDungeonMaster)
            {
                <a class="me" href="character/@Viewer.ID" title="Your character">
                    <img src="@Viewer.AvatarUrl" alt="" width="26" height="26" />
                    <span>@Viewer.Name</span>
                </a>
            }
            else
            {
                <span class="me">
                    <img src="@Viewer.AvatarUrl" alt="" width="26" height="26" />
                    <span>@Viewer.Name</span>
                    <span class="chip accent">DM</span>
                </span>
            }
            <a class="signout" href="logout">Sign out</a>
        }
    </div>
</header>

<main>
    @Body
</main>

@code {
    // A character or a scene belongs under its list's tab, though its address doesn't start with the list's
    private string? ActiveFor(params string[] prefixes) =>
        prefixes.Any(Nav.ToBaseRelativePath(Nav.Uri).StartsWith) ? "active" : null;
}
