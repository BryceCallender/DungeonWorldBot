@namespace DungeonWorldBot.Dashboard.Components
@using DungeonWorldBot.Dashboard.Models.Encounters
@using DungeonWorldBot.Dashboard.Services.Encounters
@using DungeonWorldBot.Features.Encounters
@using DungeonWorldBot.Rules
@inject PartyReader PartyReader
@inject ISpotlightService SpotlightService
@inject PortraitStore PortraitStore
@inject FightReplayReader Replays
@inject Viewer Viewer

@* The fight on an encounter scene, beside its board. The board page doesn't refresh itself, so app.js swaps in a fresh
   copy of this from api/scenes/{id}/encounter/panel whenever the bot changes something. Players only see how hurt each
   enemy looks; whoever runs the fight (the DM, or anyone with sign-in off) sees its numbers, and gets buttons for the
   dialogs on the scene page that run it. Everyone sees the spotlight. Fights on other scenes don't show here. *@

@* data-view-only tells the board (canvas.ts) to only let them look, as the server only lets them; data-fight says
   there's a fight on, so moves can be made from its tokens *@
<section class="encounter-panel" data-encounter-panel="@SceneID" data-view-only="@(_viewOnly ? "true" : null)" data-fight="@(_encounter is null ? null : "true")">
    @if (_encounter is not { } encounter)
    {
        <h2>Fight</h2>
        <p class="enemy-empty">No fight going on.</p>
        @if (_lastFight is { } last)
        {
            <a class="tool panel-action replay-link" href="fight/@last.ID">▶ Replay @last.Name</a>
        }
        @if (_canRun)
        {
            <button type="button" class="tool panel-action has-icon" data-open-dialog="start-fight"><Icon Name="sword" />Start a fight here</button>
        }
    }
    else
    {
        <h2 class="has-icon"><Icon Name="sword" />@encounter.Name</h2>

        @* How far below their max each fighter is, for the numbers that float off tokens as they're hurt and healed
           (canvas.ts). For enemies, players get only the damage the timeline already shows them, since how much HP
           an enemy's lost, beside how hurt it looks, would give away its max. *@
        <ul hidden data-wounds>
            @foreach (var enemy in encounter.Enemies)
            {
                <li data-fighter="@TokenFighter.Enemy(enemy.ID)" data-name="@enemy.Name" data-hurt="@(_canRun ? enemy.MaxHP - enemy.CurrentHP : _damageTaken.GetValueOrDefault(enemy.Name))"
                    data-badges="@EnemyBadge(enemy.Condition)" data-badge-title="@EnemyConditions.Describe(enemy.Condition)"></li>
            }
            @foreach (var c in _fighters)
            {
                var badges = CharacterBadges(c);
                <li data-fighter="@TokenFighter.Character(c.Character.ID.Value)" data-name="@c.Name" data-hurt="@(c.MaxHP - c.CurrentHP)"
                    data-badges="@string.Join(" ", badges.Select(b => b.Icon))" data-badge-title="@string.Join(", ", badges.Select(b => b.Title))"></li>
            }
            @foreach (var npc in _npcs)
            {
                <li data-fighter="@TokenFighter.Npc(npc.ID)" data-name="@npc.Name" data-hurt="@(npc.MaxHP - npc.CurrentHP)"
                    data-badges="@(npc.CurrentHP <= 0 ? "💀" : null)" data-badge-title="@(npc.CurrentHP <= 0 ? "Down" : null)"></li>
            }
        </ul>

        @* The party's spotlight as faces along the top of the board, which app.js moves there from here: whoever acted
           last glows, and anyone who hasn't acted yet pulses, so the DM can see who to turn to next *@
        @if (_spotlight is { } ribbon && ribbon.Party.Count + ribbon.Allies.Count > 0)
        {
            var latest = ribbon.Party.Concat(ribbon.Allies).Where(l => l.Last is not null).MaxBy(l => l.Last!.At);
            <template data-ribbon>
                <ol class="spotlight-ribbon" aria-label="Spotlight">
                    @foreach (var line in ribbon.Party.Concat(ribbon.Allies))
                    {
                        var view = line.CharacterID is { } id ? _party.FirstOrDefault(c => c.Character.ID.Value == id.Value) : null;
                        <li class="ribbon-who classed @(line == latest ? "latest" : null) @(line.Quiet ? "quiet" : null)" style="@(view is null ? null : Lookup.ColorOf(view.Character.Class.Type))"
                            title="@RibbonTitle(line)">
                            <span class="ribbon-face">
                                <Face Name="@line.Name" Picture="@(line.CharacterID is { } cid ? _portraits.GetValueOrDefault(cid.Value) : null)" />
                                @if (line.Actions > 0)
                                {
                                    <span class="ribbon-count">@line.Actions</span>
                                }
                            </span>
                            <span class="ribbon-name">@line.Name</span>
                        </li>
                    }
                </ol>
            </template>
        }
        @if (_viewOnly)
        {
            <p class="view-only-note">You're not in this fight, so you can watch but not change the board.</p>
        }
        @if (encounter.Enemies.Count == 0)
        {
            <p class="enemy-empty">No enemies yet.</p>
        }
        else
        {
            <ol class="enemy-list">
                @foreach (var enemy in EnemySheet.Ordered(encounter.Enemies))
                {
                    <li class="enemy @(enemy.Condition == EnemyCondition.Defeated ? "defeated" : null)" data-enemy="@enemy.Name" data-enemy-id="@enemy.ID">
                        @if (_canRun)
                        {
                            <details>
                                <summary>@Head(enemy)</summary>
                                @Details(enemy)
                            </details>
                        }
                        else
                        {
                            <div class="enemy-head">@Head(enemy)</div>
                        }
                    </li>
                }
            </ol>
        }
        @if (_spotlight is { } spotlight && (spotlight.Party.Count > 0 || spotlight.Allies.Count > 0 || spotlight.Enemies.Count > 0))
        {
            @* Dungeon World has no turns, so this is who's been quiet rather than whose go it is *@
            <h2 class="spotlight-head">
                <span>Spotlight</span>
                @if (spotlight.Misses > 0)
                {
                    <span class="chip warn" title="Misses this fight: each is a chance for a DM move">@spotlight.Misses 6-</span>
                }
            </h2>
            @if (spotlight.Party.Count > 0)
            {
                @Lines("Party", spotlight.Party)
            }
            @if (spotlight.Allies.Count > 0)
            {
                @Lines("Allies", spotlight.Allies)
            }
            @if (spotlight.Enemies.Count > 0)
            {
                @Lines("Enemies", spotlight.Enemies)
            }
        }
        @if (_canRun)
        {
            <div class="panel-actions">
                <button type="button" class="tool panel-action" data-open-dialog="add-enemies">+ Add enemies</button>
                <button type="button" class="tool panel-action" data-open-dialog="end-fight">End fight</button>
            </div>
        }
    }
</section>

@code {
    /// <summary>
    /// The scene it's beside, by its short ID.
    /// </summary>
    [Parameter, EditorRequired]
    public string SceneID { get; set; } = "";

    private Encounter? _encounter;
    private bool _canRun;
    private bool _viewOnly;
    private Spotlight? _spotlight;
    private Encounter? _lastFight;
    private Dictionary<string, int> _damageTaken = new();
    private Dictionary<ulong, string> _characterUrls = new();
    private IReadOnlyList<CharacterView> _party = [];
    private IReadOnlyDictionary<ulong, string> _portraits = new Dictionary<ulong, string>();

    // The characters and NPCs in the fight: the ones the DM picked, or everyone when they picked nobody
    private List<CharacterView> _fighters = [];
    private List<Npc> _npcs = [];

    protected override async Task OnInitializedAsync()
    {
        _encounter = await PartyReader.GetEncounterAsync(SceneID);
        _canRun = Viewer.CanRunGame;
        _viewOnly = !FightBoard.CanChange(_encounter, Viewer);
        if (_encounter is null)
            _lastFight = await Replays.GetLastEndedOnSceneAsync(SceneID);

        if (_encounter is { } encounter)
        {
            var party = _party = await PartyReader.GetPartyAsync();
            _characterUrls = party.ToDictionary(c => c.Character.ID.Value, c => c.Url);
            _spotlight = await SpotlightService.GetAsync(encounter, party.Select(c => c.Character));
            _portraits = await PortraitStore.UrlsAsync();
            if (!_canRun)
                _damageTaken = await Replays.DamageTakenAsync(encounter.ID);

            var everyone = encounter.Participants.Count == 0;
            _fighters = party.Where(c => everyone || encounter.Participants.Any(p => p.CharacterID == c.Character.ID)).ToList();
            _npcs = (await PartyReader.GetNpcsAsync()).Where(n => everyone || encounter.Participants.Any(p => p.NpcID == n.ID)).ToList();
        }
    }

    // The little icons over a fighter's token on the board (canvas.ts): how hurt an enemy looks, a character's debilities
    private static string? EnemyBadge(EnemyCondition condition) => condition switch
    {
        EnemyCondition.Hurt => "🤕",
        EnemyCondition.Bloodied => "🩸",
        EnemyCondition.NearDeath => "💀",
        _ => null,
    };

    private record Badge(string Icon, string Title);

    private static List<Badge> CharacterBadges(CharacterView c)
    {
        var badges = DebilityRules.Current(c.Character)
            .Select(d => new Badge(d switch
            {
                DebilityType.Weak => "😩",
                DebilityType.Shaky => "🫨",
                DebilityType.Sick => "🤢",
                DebilityType.Stunned => "💫",
                DebilityType.Confused => "😵‍💫",
                _ => "🩹",
            }, DebilityRules.Describe(d)))
            .ToList();
        if (c.MaxHP > 0 && c.CurrentHP <= 0)
            badges.Insert(0, new Badge("💀", "At 0 HP"));
        return badges;
    }

    private static string RibbonTitle(SpotlightLine line) =>
        line.Last is { } last ? $"{line.Name} · {Count(line)} · last: {last.Summary}" : $"{line.Name} · {Count(line)}";

    private static string Count(SpotlightLine line) => line switch
    {
        { Actions: 0, Quiet: true } => "hasn't acted",
        { Actions: 0 } => "—",
        _ => Plural(line.Actions, "action"),
    };

    private RenderFragment Lines(string side, IReadOnlyList<SpotlightLine> lines) =>
        @<div class="spotlight-side">
            <h3>@side</h3>
            <ol class="spotlight-list">
                @foreach (var line in lines)
                {
                    <li class="spotlight @(line.Quiet ? "quiet" : null)">
                        <div class="spotlight-row">
                            @if (line.CharacterID is { } id && _characterUrls.TryGetValue(id.Value, out var url))
                            {
                                <a class="name" href="@url">@line.Name</a>
                            }
                            else
                            {
                                <span class="name">@line.Name</span>
                            }
                            <span class="muted">@Count(line)</span>
                        </div>
                        @if (line.Last is { } last)
                        {
                            <ActionParts Action="last" Title="@($"{last.At.ToLocalTime():t}: {last.Summary}")" />
                        }
                    </li>
                }
            </ol>
        </div>;

    private static RenderFragment Head(Enemy enemy) =>
        @<span class="enemy-row">
            <span class="name">@enemy.Name</span>
            <span class="chip condition @enemy.Condition.ToString().ToLowerInvariant()">@EnemyConditions.Describe(enemy.Condition)</span>
        </span>;

    private static RenderFragment Details(Enemy enemy) =>
        @<div class="enemy-details">
            <HealthBar Current="enemy.CurrentHP" Max="enemy.MaxHP" />
            <div class="enemy-stats">
                <span title="Armor"><Icon Name="shield" />@enemy.Armor</span>
                @if (enemy.Damage is not null)
                {
                    <span title="Damage"><Icon Name="sword" />@enemy.Damage</span>
                }
            </div>
            @if (enemy.Tags is not null)
            {
                <div class="muted">@enemy.Tags</div>
            }
            @if (enemy.Instinct is not null)
            {
                <div><strong>Instinct</strong> @enemy.Instinct</div>
            }
            @if (enemy.Moves is not null)
            {
                <ul class="enemy-moves">
                    @foreach (var move in EnemySheet.SplitMoves(enemy.Moves))
                    {
                        <li>@move</li>
                    }
                </ul>
            }
            @if (enemy.Notes is not null)
            {
                <div class="muted">@enemy.Notes</div>
            }
        </div>;
}
