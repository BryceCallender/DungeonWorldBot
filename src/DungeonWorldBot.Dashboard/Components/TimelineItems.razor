@using DungeonWorldBot.Features.Encounters

@* A page of the timeline, newest first: the latest in its card, or the next older ones fetched by "Show older". After
   the last, the fight starting. Each keeps its time in data-at, as ticks, for fetching what came before. *@
@foreach (var entry in Page.Entries)
{
    <li class="timeline-entry @(entry.Action.Missed ? "miss" : null)" data-at="@entry.Action.At.UtcTicks">
        <div class="timeline-row">
            <span class="name">@entry.Actor</span>
            <span class="time">@entry.Action.At.ToLocalTime().ToString("t")</span>
        </div>
        <ActionParts Action="entry.Action" Title="@entry.Action.Summary" />
    </li>
}
@if (Page.HasMore && Page.Entries is [.., var oldest])
{
    <li class="timeline-more">
        <button type="button" class="tool" data-timeline-older="@oldest.Action.At.UtcTicks">Show older</button>
    </li>
}
else
{
    <li class="timeline-entry start">
        <div class="timeline-row">
            <span class="muted">Fight started</span>
            <span class="time">@StartedAt.ToLocalTime().ToString("t")</span>
        </div>
    </li>
}

@code {
    [Parameter, EditorRequired]
    public TimelinePage Page { get; set; } = null!;

    [Parameter, EditorRequired]
    public DateTimeOffset StartedAt { get; set; }
}
