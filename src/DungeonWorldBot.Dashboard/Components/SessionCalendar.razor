@* A month grid for each month from the first session to the latest, newest first, with game nights marked. The latest
   few are open; older ones fold away so a long campaign isn't a wall of calendars. Clicking a night pops up how it went. *@
<div class="calendar">
    @foreach (var month in _months.Take(RecentMonths))
    {
        @Month(month)
    }
</div>

@if (_months.Count > RecentMonths)
{
    var older = _months.Count - RecentMonths;
    <details class="cal-older">
        <summary class="tool">Show @older older month@(older == 1 ? "" : "s")</summary>
        <div class="calendar">
            @foreach (var month in _months.Skip(RecentMonths))
            {
                @Month(month)
            }
        </div>
    </details>
}

@code {
    private const int RecentMonths = 4;

    private RenderFragment Month(DateTime month) => __builder =>
    {
        <section class="card cal-month">
            <h3>@month.ToString("MMMM yyyy")</h3>
            <div class="cal-grid">
                @foreach (var day in WeekDays)
                {
                    <span class="cal-weekday">@day</span>
                }
                @for (var i = 0; i < (int)month.DayOfWeek; i++)
                {
                    <span></span>
                }
                @for (var d = 1; d <= DateTime.DaysInMonth(month.Year, month.Month); d++)
                {
                    var date = new DateTime(month.Year, month.Month, d);
                    if (_byDay.TryGetValue(date, out var session))
                    {
                        var id = $"session-{date:yyyy-MM-dd}";
                        <button type="button" class="cal-day played" popovertarget="@id" style="--busy: @Busy(session)"
                                aria-label="@session.Started.ToString("dddd, MMMM d"): @session.Rolls rolls">@d</button>
                        <div id="@id" class="cal-pop card" popover>
                            @if (session.Name is { } name)
                            {
                                <strong>@name</strong>
                                <span class="small muted">@session.Started.ToString("ddd, MMM d, yyyy")</span>
                            }
                            else
                            {
                                <strong>@session.Started.ToString("ddd, MMM d, yyyy")</strong>
                            }
                            <dl>
                                <dt>Players</dt><dd>@session.Players</dd>
                                <dt>Rolls</dt><dd>@session.Rolls</dd>
                                <dt>Hit rate</dt><dd>@Percent(session.Hits, session.Rolls)</dd>
                                <dt>Misses</dt><dd>@session.Misses</dd>
                                <dt>Nat 12s</dt><dd>@session.Natural12s</dd>
                                <dt>Nat 2s</dt><dd>@session.Natural2s</dd>
                                <dt>Avg dice</dt><dd class="@Luck(session)">@session.AverageNatural.ToString("0.0")</dd>
                            </dl>
                            @if (session.Number is { } number)
                            {
                                <a class="small" href="session/@number">Open the session →</a>
                            }
                        </div>
                    }
                    else
                    {
                        <span class="cal-day @(date == DateTime.Today ? "today" : "")">@d</span>
                    }
                }
            </div>
        </section>
    };

    private static readonly string[] WeekDays = ["S", "M", "T", "W", "T", "F", "S"];

    [Parameter, EditorRequired]
    public IReadOnlyList<SessionRolls> Sessions { get; set; } = [];

    private Dictionary<DateTime, SessionRolls> _byDay = new();
    private List<DateTime> _months = [];
    private int _mostRolls = 1;

    protected override void OnParametersSet()
    {
        _byDay = Sessions.GroupBy(s => s.Started.Date).ToDictionary(g => g.Key, g => g.First());
        _mostRolls = Math.Max(1, Sessions.Select(s => s.Rolls).DefaultIfEmpty().Max());

        _months = [];
        if (Sessions.Count == 0)
            return;

        var first = Sessions.Min(s => s.Started);
        var last = Sessions.Max(s => s.Started);
        for (var month = new DateTime(last.Year, last.Month, 1); month >= new DateTime(first.Year, first.Month, 1); month = month.AddMonths(-1))
            _months.Add(month);
    }

    // Busier nights are a deeper colour, but even a quiet one stands out
    private string Busy(SessionRolls session) =>
        (0.6 + 0.4 * session.Rolls / _mostRolls).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    // Same call-out as the player table: half a pip from fair, over enough rolls to mean something
    private static string Luck(SessionRolls session) => session switch
    {
        { Rolls: >= 10, AverageNatural: >= 7.5 } => "lucky",
        { Rolls: >= 10, AverageNatural: <= 6.5 } => "unlucky",
        _ => "",
    };

    private static string Percent(int count, int total) => total == 0 ? "0%" : $"{count * 100 / total}%";
}
